{
  "expo": {
    "name": "Kairos Admissions",
    "slug": "vici",
    "scheme": "kairosadmissions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kairosadmissions.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kairosadmissions.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6EC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fecae186-154a-42b4-a2ab-ad01a4a1cdfe"
      }
    },
    "owner": "ari-agarwals-team"
  }
}
